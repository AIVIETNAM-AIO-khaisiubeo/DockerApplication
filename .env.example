# File mẫu cấu hình máy cá nhân. Sao chép thành .env; đừng commit .env lên GitHub.
# Windows PowerShell: Copy-Item .env.example .env
# Git Bash / Linux / macOS: cp .env.example .env
UI_PORT=8501
POSTGRES_DB=medtriage
POSTGRES_USER=medtriage
# Mật khẩu mẫu chỉ dành cho máy phát triển local; không dùng y nguyên khi triển khai.
POSTGRES_PASSWORD=change_me
# Chế độ chạy của Vision: mock = kết quả giả để thử API; real = model thật (chỉ dùng khi P2 hoàn tất).
MODEL_MODE=mock
# Chế độ chạy của LLM: mock = câu trả lời mẫu; real = LLM thật (chỉ dùng khi P3 hoàn tất).
LLM_MODE=mock
# Chỉ đặt 1 khi chạy bài kiểm tra cố ý làm LLM gặp lỗi; để 0 khi làm việc bình thường.
ENABLE_DEBUG=0
