# Sao chép thành .env rồi ĐỔI mật khẩu trước khi demo.  (.env không được commit)

# --- 04-db: tài khoản admin PostgreSQL (chỉ dùng cho migration/quản trị) ---
POSTGRES_DB=medtriage
POSTGRES_USER=medtriage
POSTGRES_PASSWORD=change_me_admin

# --- Role quyền tối thiểu mà UI dùng (SELECT/INSERT, UPDATE medical_history) ---
APP_POSTGRES_USER=medtriage_app
APP_POSTGRES_PASSWORD=change_me_app

# --- 03-llm ---
# mock: dùng template | real: gọi API chuẩn OpenAI (Ollama/Groq/OpenAI)
LLM_MODE=mock
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=
LLM_TIMEOUT_S=60
ENABLE_DEBUG=0

# --- 01-ui ---
# 1 = UI tự giả lập Vision/LLM/DB (không gọi service khác)
UI_MOCK_BACKENDS=0

# --- Cổng trên máy host ---
UI_PORT=8501
VISION_PORT=8001
LLM_PORT=8002
